GOOGLE_CLIENT_ID=<google-oauth-client-id>
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
DYNAMODB_TABLE_NAME=<dynamodb-table-name>
MAX_MESSAGE_LENGTH=<positive-integer>
MAX_REQUEST_BYTES=<positive-integer>
USER_DAILY_LIMIT=<positive-integer>
GLOBAL_HOURLY_LIMIT=<positive-integer>
GLOBAL_DAILY_LIMIT=<positive-integer>
CX_TIMEOUT_SECONDS=<positive-integer>
SESSION_HMAC_SECRET=<hex-encoded-hmac-secret>
SESSION_TOKEN_TTL_SECONDS=86400
MAX_CONVERSATION_TOKEN_LENGTH=4096